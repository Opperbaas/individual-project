@model PresentationLayer.Models.GenerateTimeSlotsViewModel

@{
    ViewData["Title"] = "Tijdsloten genereren";
}

<h1>Tijdsloten genereren</h1>
<p>Maak in één keer meerdere tijdsloten aan voor dit evenement.</p>

<form asp-controller="TimeSlot" asp-action="Generate" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="EventId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DailyStartTime" class="form-label"></label>
            <input asp-for="DailyStartTime" type="time" class="form-control" />
            <span asp-validation-for="DailyStartTime" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DailyEndTime" class="form-label"></label>
            <input asp-for="DailyEndTime" type="time" class="form-control" />
            <span asp-validation-for="DailyEndTime" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="IntervalMinutes" class="form-label"></label>
        <input asp-for="IntervalMinutes" type="number" min="1"
               class="form-control" />
        <span asp-validation-for="IntervalMinutes" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="col-form-label">Dagen</legend>
        @foreach (var day in Enum.GetValues<DayOfWeek>())
        {
            var selected = Model.Days.Contains(day);
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="Days"
                       value="@day"
                       id="day-@day"
                       checked="@(selected ? "checked" : null)" />
                <label class="form-check-label" for="day-@day">
                    @day
                </label>
            </div>
        }
    </fieldset>

    <button type="submit" class="btn btn-primary">
        Tijdsloten genereren
    </button>
    <a asp-controller="Planning" asp-action="Index"
       asp-route-eventId="@Model.EventId"
       class="btn btn-outline-secondary">
        Annuleren
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

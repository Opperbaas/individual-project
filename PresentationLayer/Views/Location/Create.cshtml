@model PresentationLayer.Models.CreateLocationViewModel
@using BusinessLayer.Enums

@{
    ViewData["Title"] = "Locatie toevoegen";
}

<h1>Locatie toevoegen</h1>

<form asp-controller="Location" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="EventId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LocationType" class="form-label"></label>
        <select asp-for="LocationType" class="form-select">
            @foreach (var locationType in LocationTypes.All)
            {
                <option value="@locationType">@locationType</option>
            }
        </select>
        <span asp-validation-for="LocationType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Capacity" class="form-label"></label>
        <input asp-for="Capacity" type="number" min="1" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Locatie toevoegen</button>
    <a asp-controller="@(Model.EventId > 0 ? "SportEvent" : "Home")"
       asp-action="@(Model.EventId > 0 ? "Manage" : "Index")"
       asp-route-id="@(Model.EventId > 0 ? Model.EventId : null)"
       class="btn btn-outline-secondary">
        Annuleren
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model PresentationLayer.Models.CreateLocationViewModel

@{
    ViewData["Title"] = "Locatie toevoegen";
}

<h1>Locatie toevoegen</h1>

<form asp-controller="Location" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LocationType" class="form-label"></label>
        <input asp-for="LocationType" class="form-control" />
        <span asp-validation-for="LocationType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Capacity" class="form-label"></label>
        <input asp-for="Capacity" type="number" min="1" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Locatie toevoegen</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        Annuleren
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

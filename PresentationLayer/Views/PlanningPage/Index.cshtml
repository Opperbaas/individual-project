@model IReadOnlyList<BusinessLayer.Entities.Planning>

@{
    ViewData["Title"] = "Planningen";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Planningen</h1>
        <p class="text-muted mb-0">Overzicht van de planningen voor dit evenement.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Er zijn nog geen planningen voor dit evenement.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var planning in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">@planning.Name</h2>
                        <p class="card-text mb-2">
                            Status:
                            <span class="badge text-bg-secondary">@planning.Status</span>
                        </p>
                        <p class="card-text text-muted">
                            Aangemaakt op @planning.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                        </p>
                        <a class="btn btn-primary"
                           asp-controller="Planning"
                           asp-action="Details"
                           asp-route-id="@planning.PlanningId">
                            Details bekijken
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

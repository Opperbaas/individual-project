@model IReadOnlyList<BusinessLayer.Entities.Planning>

@{
    ViewData["Title"] = "Planningen";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Planningen</h1>
        <p class="text-muted mb-0">Overzicht van de planningen voor dit evenement.</p>
    </div>
    @if (User.IsInRole("Organizer"))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary"
               asp-controller="Planning"
               asp-action="Create"
               asp-route-eventId="@Context.Request.Query["eventId"]">
                Planning aanmaken
            </a>
            <form asp-controller="Planning"
                  asp-action="GenerateOptimized"
                  method="post"
                  class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="eventId"
                       value="@Context.Request.Query["eventId"]" />
                <input class="form-control"
                       name="name"
                       value="Geoptimaliseerde planning"
                       aria-label="Naam van de geoptimaliseerde planning" />
                <button type="submit" class="btn btn-outline-success">
                    Optimaliseer planning
                </button>
            </form>
            <form asp-controller="Planning"
                  asp-action="GenerateWithAi"
                  method="post"
                  class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="eventId"
                       value="@Context.Request.Query["eventId"]" />
                <input class="form-control"
                       name="name"
                       value="AI-planning"
                       aria-label="Naam van de AI-planning" />
                <button type="submit" class="btn btn-outline-primary">
                    Genereer met AI
                </button>
            </form>
        </div>
    }
</div>

@if (TempData["ErrorMessage"] is string planningError)
{
    <div class="alert alert-danger">@planningError</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Er zijn nog geen planningen voor dit evenement.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var planning in Model)
        {
            var hasMissingVolunteers = planning.ActivitySchedules.Any() &&
                planning.ActivitySchedules.Any(
                    schedule => schedule.VolunteerAssignments.Count == 0);
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm @(hasMissingVolunteers ? "border-danger" : "")">
                    <div class="card-body">
                        <h2 class="h5 card-title">@planning.Name</h2>
                        <p class="card-text mb-2">
                            Status:
                            <span class="badge @(hasMissingVolunteers ? "text-bg-danger" : "text-bg-secondary")">
                                @(hasMissingVolunteers ? "Vrijwilliger ontbreekt" : planning.Status)
                            </span>
                        </p>
                        @if (hasMissingVolunteers)
                        {
                            <p class="text-danger">
                                Voor één of meer activiteiten is nog geen vrijwilliger ingepland.
                            </p>
                        }
                        <p class="card-text text-muted">
                            Aangemaakt op @planning.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                        </p>
                        <a class="btn btn-primary"
                           asp-controller="Planning"
                           asp-action="Details"
                           asp-route-id="@planning.PlanningId">
                            Details bekijken
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model PresentationLayer.Models.EditPlanningViewModel

@{
    ViewData["Title"] = "Planning bewerken";
}

<h1>Planning bewerken</h1>

<form asp-controller="Planning" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="PlanningId" type="hidden" />
    <input asp-for="EventId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Evenement</label>
        <input value="@Model.EventName" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Planning</label>
        <input value="@Model.Name" class="form-control" readonly />
    </div>

    <h2 class="h4 mt-4">Activiteitenschema's</h2>

    @if (Model.Schedules.Count == 0)
    {
        <div class="alert alert-info">
            Er zijn nog geen activiteitenschema's aan deze planning toegevoegd.
        </div>
    }
    else
    {
        @for (var index = 0; index < Model.Schedules.Count; index++)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <input asp-for="Schedules[index].ActivityScheduleId" type="hidden" />

                    <div class="mb-3">
                        <label class="form-label">Activiteit</label>
                        <input value="@Model.Schedules[index].Activities.Single(item => item.Selected).Text"
                               class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Locatie</label>
                        <input value="@Model.Schedules[index].Locations.Single(item => item.Selected).Text"
                               class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tijdslot</label>
                        <input value="@Model.Schedules[index].TimeSlots.Single(item => item.Selected).Text"
                               class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Schedules[index].VolunteerIds" class="form-label"></label>
                        <select asp-for="Schedules[index].VolunteerIds"
                                asp-items="Model.Schedules[index].Volunteers"
                                class="form-select"
                                multiple>
                        </select>
                    </div>
                </div>
            </div>
        }
    }

    <button type="submit" class="btn btn-primary">Wijzigingen opslaan</button>
    <a asp-controller="Planning"
       asp-action="Details"
       asp-route-id="@Model.PlanningId"
       class="btn btn-outline-secondary">
        Annuleren
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

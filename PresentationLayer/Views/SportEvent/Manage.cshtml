@model PresentationLayer.Models.ManageSportEventViewModel
@using BusinessLayer.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Evenement beheren";
    var generationModel = new GenerateActivitiesViewModel
    {
        EventId = Model.EventId,
        ActivityRows =
        [
            new GenerateActivityRowViewModel
            {
                LocationId = Model.Locations.FirstOrDefault()?.LocationId ?? 0
            }
        ]
    };
}

<style>
    .manage-overview-card {
        max-height: 560px;
        overflow: hidden;
    }

    .manage-overview-card .card-body {
        display: flex;
        flex-direction: column;
    }

    .manage-scroll-list {
        max-height: 420px;
        overflow-y: auto;
        padding-right: 0.25rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1>@Model.EventName beheren</h1>
        <p class="text-muted mb-0">
            @Model.StartDate.ToString("dd-MM-yyyy") -
            @Model.EndDate.ToString("dd-MM-yyyy")
        </p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="SportEvent"
       asp-action="Index">
        Terug naar evenementen
    </a>
    <a class="btn btn-primary ms-2"
       asp-controller="SportEvent"
       asp-action="Edit"
       asp-route-id="@Model.EventId">
        Evenement bewerken
    </a>
    <form asp-controller="SportEvent"
          asp-action="Delete"
          method="post"
          class="ms-2"
          onsubmit="return confirm('Weet u zeker dat u dit evenement wilt verwijderen?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.EventId" />
        <button type="submit" class="btn btn-outline-danger">
            Evenement verwijderen
        </button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p>@Model.Description</p>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 manage-overview-card">
            <div class="card-body">
                <h2 class="h5">Activiteiten</h2>
                <p>Voeg activiteiten toe voor dit evenement.</p>
                <a class="btn btn-primary"
                   asp-controller="Activity"
                   asp-action="Create"
                   asp-route-eventId="@Model.EventId">
                    Activiteit toevoegen
                </a>
                @if (Model.Activities.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">Nog geen activiteiten voor dit evenement.</p>
                }
                else
                {
                    <ul class="mt-3 mb-0 ps-3 manage-scroll-list">
                        @foreach (var activity in Model.Activities)
                        {
                            <li>
                                <strong>@activity.ActivityName</strong>
                                (@activity.ActivityType, max. @activity.MaxParticipants)
                                <div class="mt-1">
                                    <a asp-controller="Activity"
                                       asp-action="Edit"
                                       asp-route-id="@activity.ActivityId"
                                       class="btn btn-sm btn-outline-primary">
                                        Bewerken
                                    </a>
                                    <form asp-controller="Activity"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Deze activiteit verwijderen?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@activity.ActivityId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Verwijderen
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>


    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 manage-overview-card">
            <div class="card-body">
                <h2 class="h5">Tijdsloten</h2>
                <p>Voeg tijdsloten toe voor dit evenement.</p>
                <a class="btn btn-primary"
                   asp-controller="TimeSlot"
                   asp-action="Create"
                   asp-route-eventId="@Model.EventId">
                    Tijdslot toevoegen
                </a>
                @if (Model.TimeSlots.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">Nog geen tijdsloten voor dit evenement.</p>
                }
                else
                {
                    <p class="small text-muted mt-2 mb-1">
                        @Model.TimeSlots.Count tijdsloten
                    </p>
                    <ul class="mt-1 mb-0 ps-3 manage-scroll-list">
                        @foreach (var timeSlot in Model.TimeSlots)
                        {
                            <li>
                                @timeSlot.SlotDate.ToString("dd-MM-yyyy")
                                @timeSlot.StartTime.ToString("HH:mm") -
                                @timeSlot.EndTime.ToString("HH:mm")
                                <div class="mt-1">
                                    <a asp-controller="TimeSlot"
                                       asp-action="Edit"
                                       asp-route-id="@timeSlot.TimeSlotId"
                                       class="btn btn-sm btn-outline-primary">
                                        Bewerken
                                    </a>
                                    <form asp-controller="TimeSlot"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Dit tijdslot verwijderen?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@timeSlot.TimeSlotId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Verwijderen
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 manage-overview-card">
            <div class="card-body">
                <h2 class="h5">Locaties</h2>
                <p>Voeg locaties toe die in planningen gebruikt kunnen worden.</p>
                <a class="btn btn-primary"
                   asp-controller="Location"
                   asp-action="Create"
                   asp-route-eventId="@Model.EventId">
                    Locatie toevoegen
                </a>
                @if (Model.Locations.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">Nog geen locaties beschikbaar.</p>
                }
                else
                {
                    <ul class="mt-3 mb-0 ps-3 manage-scroll-list">
                        @foreach (var location in Model.Locations)
                        {
                            <li>
                                <strong>@location.Name</strong>
                                (@location.LocationType, max. @location.Capacity)
                                <div class="mt-1">
                                    <a asp-controller="Location"
                                       asp-action="Edit"
                                       asp-route-id="@location.LocationId"
                                       class="btn btn-sm btn-outline-primary">
                                        Bewerken
                                    </a>
                                    <form asp-controller="Location"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Deze locatie verwijderen?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@location.LocationId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Verwijderen
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Planningen</h2>
                <p>Maak een planning met activiteiten, locaties en tijdsloten.</p>
                <a class="btn btn-primary"
                   asp-controller="Planning"
                   asp-action="Index"
                   asp-route-eventId="@Model.EventId">
                    Planningen bekijken
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h4">Activiteiten genereren</h2>
        <p class="text-muted">
            Voeg meerdere rijen toe om in één keer verschillende activiteiten te genereren.
        </p>

        @if (Model.Locations.Count == 0)
        {
            <div class="alert alert-warning">
                Voeg eerst een locatie toe voordat je activiteiten genereert.
            </div>
        }
        else
        {
            <form asp-controller="SportEvent"
                  asp-action="GenerateActivities"
                  method="post">
                @Html.AntiForgeryToken()
                <input name="EventId" value="@generationModel.EventId" type="hidden" />

                <div id="activityRows">
                    @for (var index = 0; index < generationModel.ActivityRows.Count; index++)
                    {
                        <div class="activity-row border rounded p-3 mb-3">
                            <div class="row g-3">
                                <div class="col-md-6 col-lg-3">
                                    <label for="ActivityRows_@(index)__LocationType" class="form-label">Locatietype</label>
                                    <select name="ActivityRows[@index].LocationType"
                                            id="ActivityRows_@(index)__LocationType"
                                            asp-items="LocationTypes.All.Select(type => new SelectListItem(type, type))"
                                            class="form-select row-location-type">
                                    </select>
                                </div>

                                <div class="col-md-6 col-lg-3">
                                    <label for="ActivityRows_@(index)__ExecutionType" class="form-label">Uitvoeringsvorm</label>
                                    <select name="ActivityRows[@index].ExecutionType"
                                            id="ActivityRows_@(index)__ExecutionType"
                                            asp-items="ExecutionTypes.All.Select(type => new SelectListItem(type, type))"
                                            class="form-select">
                                    </select>
                                </div>

                                <div class="col-md-6 col-lg-3">
                                    <label for="ActivityRows_@(index)__LocationId" class="form-label">Locatie</label>
                                    <select name="ActivityRows[@index].LocationId"
                                            id="ActivityRows_@(index)__LocationId"
                                            class="form-select row-location">
                                        @foreach (var location in Model.Locations)
                                        {
                                            <option value="@location.LocationId"
                                                    data-location-type="@location.LocationType">
                                                @location.Name (@location.LocationType)
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6 col-lg-1">
                                    <label for="ActivityRows_@(index)__Count" class="form-label">Aantal</label>
                                    <input name="ActivityRows[@index].Count"
                                           id="ActivityRows_@(index)__Count"
                                           value="@generationModel.ActivityRows[index].Count"
                                           type="number"
                                           min="1"
                                           max="20"
                                           class="form-control" />
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger mt-3 remove-row">
                                Rij verwijderen
                            </button>
                        </div>
                    }
                </div>

                <button type="button"
                        id="addActivityRow"
                        class="btn btn-outline-primary">
                    Nog een rij toevoegen
                </button>
                <button type="submit" class="btn btn-primary ms-2">
                    Activiteiten genereren
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/manage-sport-event.js"></script>
}

@model IReadOnlyList<PresentationLayer.Models.SportEventViewModel>

@{
    ViewData["Title"] = "Sportevenementen";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Sportevenementen</h1>
        <p class="text-muted mb-0">Kies een evenement om de planning te bekijken.</p>
    </div>
    <a class="btn btn-primary"
       asp-controller="SportEvent"
       asp-action="Create">
        Evenement aanmaken
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Er zijn nog geen sportevenementen.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var sportEvent in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">@sportEvent.EventName</h2>
                        <p class="card-text">@sportEvent.Description</p>
                        <p class="card-text text-muted">
                            @sportEvent.StartDate.ToString("dd-MM-yyyy")
                            -
                            @sportEvent.EndDate.ToString("dd-MM-yyyy")
                        </p>
                        <a class="btn btn-outline-primary"
                           asp-controller="Planning"
                           asp-action="Index"
                           asp-route-eventId="@sportEvent.EventId">
                            Planning bekijken
                        </a>
                        <a class="btn btn-primary"
                           asp-controller="SportEvent"
                           asp-action="Manage"
                           asp-route-id="@sportEvent.EventId">
                            Beheren
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
